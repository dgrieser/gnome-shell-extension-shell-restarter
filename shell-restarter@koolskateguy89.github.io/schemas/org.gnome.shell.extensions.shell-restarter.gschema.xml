<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.shell-restarter" path="/org/gnome/shell/extensions/shell-restarter/">

    <key name="restart-message" type="s">
      <default>'Restarting...'</default>
    </key>

    <key name="show-indicator" type="b">
      <default>true</default>
      <summary>Show reload button in top bar</summary>
    </key>

    <key name="enable-dbus" type="b">
      <default>true</default>
      <summary>Register DBus interface</summary>
    </key>

  </schema>
</schemalist>